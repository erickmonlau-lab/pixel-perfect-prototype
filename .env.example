# ─── BreadPDF — Environment Variables ───────────────────────────────────────────
# Copy this file to .env.local and fill in your real values.
# Never commit .env.local to version control.

# ── Canonical site URL ────────────────────────────────────────────────────────
# Used in the sitemap.xml and structured data.
# Must NOT have a trailing slash.
VITE_SITE_URL=https://breadpdf.com

# ── Supabase Auth & Database (Phase 1.5) ───────────────────────────────────────
# Obtain these from: Supabase Dashboard → Settings → API
# VITE_SUPABASE_URL: Project URL (e.g., https://xyzcompany.supabase.co)
# VITE_SUPABASE_ANON_KEY: Public Anon Key (safe for browser with RLS enabled)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Server Secrets (Never expose to frontend, server-only) ────────────────────
# AUTH_SECRET: 64-char random hex string used to sign HttpOnly session cookies
AUTH_SECRET=

# ── Official Support / Communications ─────────────────────────────────────────
# Official mailbox: breadpdfstudio@gmail.com

# ── Analytics (Plausible) ─────────────────────────────────────────────────────
VITE_PLAUSIBLE_DOMAIN=

# ── AdSense (keep disabled until a consent platform is integrated) ─────────────
VITE_ADSENSE_ENABLED=false
VITE_ADSENSE_CLIENT_ID=
VITE_ADSENSE_NPA=true

# IndexNow (server-side only; NOT a browser variable)
# 32-128 caracteres [a-zA-Z0-9-]. Debe coincidir con public/<clave>.txt.
# No se define en .env.local para producción: se configura en Vercel y se
# pasa al script en el entorno de ejecución (npm run seo:indexnow).
INDEXNOW_API_KEY=
